{
  "name": "shared",
  "packageManager": "yarn@4.9.2",
  "version": "1.0.0",
  "main": "src/shared.js",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/shared.js",
    "./config/*": "./src/config/*.js",
    "./config/env": "./src/config/env.js",
    "./models/*": "./src/models/*.js",
    "./utils/*": "./src/utils/*.js"
  },
  "scripts": {
    "lint": "eslint src --ext .js",
    "format": "prettier --write src/**/*.js"
  },
  "dependencies": {
    "redis": "^5.0.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5"
  }
}
