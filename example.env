# ==========================
# Environment Configuration
# ==========================

# App environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Port to run the backend server
PORT=5000


# ==========================
# Database Configuration
# ==========================

# MongoDB connection URI (e.g. from MongoDB Atlas)
MONGODB_URI=your_mongodb_connection_string


# ==========================
# Authentication
# ==========================

# JWT secret key for signing tokens
JWT_SECRET=your_jwt_secret


# ==========================
# PayPal Integration
# ==========================

# PayPal API base URL (use sandbox or live URL)
PAYPAL_API_URL=https://api-m.sandbox.paypal.com

# PayPal client ID
PAYPAL_CLIENT_ID=your_paypal_client_id


# ==========================
# Redis Configuration
# ==========================

# Redis server URL (e.g. for sessions or caching)
REDIS_URL=redis://localhost:6379


# ==========================
# File Uploads
# ==========================

# Folder to store uploaded files (should match server config)
MESSAGING_UPLOADS_DIR=messagingUploads

# Maximum file size for uploads (in bytes, e.g. 50MB)
MAX_FILE_UPLOAD_SIZE=52428800


# ==========================
# PeerJS (WebRTC)
# ==========================

# PeerJS host for peer connections
REACT_APP_PEER_HOST=0.peerjs.com

# PeerJS port
REACT_APP_PEER_PORT=443


# ==========================
# Frontend Configuration
# ==========================

# The frontend application's base URL
FRONTEND_URL=http://localhost:3000

# The base API URL for frontend to call backend
REACT_APP_API_URL=http://localhost:5000


# ==========================
# WebSocket Configuration
# ==========================

# Port for WebSocket server (if separate)
SOCKET_PORT=5001


# ==========================
# Cloudinary (Media Hosting)
# ==========================

# Cloudinary cloud name
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Cloudinary API key
CLOUDINARY_API_KEY=your_cloudinary_api_key

# Cloudinary API secret
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
